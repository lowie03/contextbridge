{
  "manifest_version": 3,
  "name": "ContextBridge",
  "version": "0.5.0",
  "description": "Carry your AI chat work over to another chatbot.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": [
        "utils.js",
        "adapters/chatgpt.js",
        "storage.js",
        "brief.js",
        "handoff.js",
        "panel.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
